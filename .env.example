# Copier ce fichier en .env (exclu de Git) puis remplir les valeurs.

# Option A (développement local) : la clé directement
OPENWEATHER_API_KEY=

# Option B (recommandée) : la clé lue dans Secret Manager
# Laisser OPENWEATHER_API_KEY vide et renseigner l'identifiant complet du secret :
# OPENWEATHER_SECRET_ID=projects/MON_PROJET/secrets/openweather-api-key/versions/latest

# Google Cloud (utilisé aux étapes suivantes)
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_DATASET_RAW=meteo_raw
