# Copier ce fichier en .env (exclu de Git) puis remplir les valeurs.
# Ne jamais mettre de vraie valeur dans CE fichier : il est publié sur GitHub.

# Jeton Kaggle (pour télécharger le jeu Olist une seule fois)
# Option A (développement local) : le jeton directement
KAGGLE_API_TOKEN=
# Option B (recommandée) : laisser KAGGLE_API_TOKEN vide et indiquer le secret :
# KAGGLE_API_TOKEN_SECRET_ID=projects/MON_PROJET/secrets/kaggle-api-token/versions/latest

# Les API d'enrichissement (taux de change, jours fériés, IBGE) n'ont pas besoin de clé.

# Google Cloud (pour le chargement)
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_DATASET_RAW=retail_raw
